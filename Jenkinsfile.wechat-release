pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(name: 'SOURCE_REF', defaultValue: 'main', description: 'Source branch containing the build commit')
        string(name: 'SOURCE_COMMIT', defaultValue: '', description: 'Exact source commit to validate and package')
        string(name: 'CONNECTOR_VERSION', defaultValue: '3.1.3', description: 'WeChat Connector version')
        string(name: 'MIN_BRIDGE_VERSION', defaultValue: '0.6.0', description: 'Minimum compatible Bridge Agent version')
    }

    stages {
        stage('Validate build input') {
            steps {
                sh '''#!/bin/bash
set -euo pipefail
test -n "$SOURCE_COMMIT"
test "$SOURCE_REF" = "main"
test "$(git rev-parse HEAD)" = "$SOURCE_COMMIT"
test "$(git config --get remote.origin.url)" = "https://gitee.com/zxflimit_admin/wechat-bridge-collector.git"
test "$(git rev-parse refs/remotes/origin/main)" = "$SOURCE_COMMIT"
test "$(jq -r '.version' connector.json)" = "$CONNECTOR_VERSION"
test "$(jq -r '.source.revision' connector.json)" = "v${CONNECTOR_VERSION}"
test "$(jq -r '.schemaVersion' connector.json)" = "3.0.0"
app_id="$(jq -er '.appId' connector.json)"
[[ "$app_id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]]
test "$(jq -r 'has("id")' connector.json)" = "false"
test "$(jq -r '.hostRequirements.minimumVersion' connector.json)" = "$MIN_BRIDGE_VERSION"
test "$(jq -r '.runtime.command' connector.json)" = "wechat-bridge-collector-python"
test "$(jq -r '.runtime.startPolicy' connector.json)" = "manual"
test "$(jq -r '.ui.entry' connector.json)" = "ui/index.html"
test "$(jq -r '.management.auth.type' connector.json)" = "connector_token"
test "$(sed -n 's/^version = "\\([^" ]*\\)"/\\1/p' pyproject.toml | head -1)" = "$CONNECTOR_VERSION"
test "$(sed -n 's/^requires-python = "\\([^" ]*\\)"/\\1/p' pyproject.toml)" = ">=3.10"
test "$(sed -n 's/^__version__ = "\\([^" ]*\\)"/\\1/p' wechat_bridge_collector/__init__.py)" = "$CONNECTOR_VERSION"
test "$(sed -n 's/^version = "\\([^" ]*\\)"/\\1/p' Cargo.toml | head -1)" = "$CONNECTOR_VERSION"
test ! -e .gitmodules
test ! -e bin/macos-x86_64/wechat-bridge-collector
test -f vendor/wechat-decrypt.upstream.json
test "$(jq -r '.commit' vendor/wechat-decrypt.upstream.json)" = "5e0eaa33fa1e77e533392db394644216c5ea6824"
test -f vendor/wechat-decrypt/key_utils.py
test -f vendor/wechat-decrypt/find_all_keys.py
test -f vendor/wechat-decrypt/find_all_keys_windows.py
test -f vendor/wechat-decrypt/find_all_keys_macos.c
test ! -e wechat_bridge_collector/scripts/macos/com.baijimu.wechat-bridge-collector.plist
! jq -e '.hooks.installAutostart' connector.json >/dev/null
case "$CONNECTOR_VERSION" in *[!0-9.]*|'') exit 1 ;; esac
case "$MIN_BRIDGE_VERSION" in *[!0-9.]*|'') exit 1 ;; esac
'''
            }
        }

        stage('Test source') {
            steps {
                sh '''#!/bin/bash
set -euo pipefail
release_python="$WORKSPACE/.release-python"
case "$release_python" in "$WORKSPACE"/*) ;; *) exit 1 ;; esac
trap 'rm -rf -- "$release_python"' EXIT
python3 -m pip install \
  --disable-pip-version-check \
  --index-url https://mirrors.aliyun.com/pypi/simple/ \
  --target "$release_python" \
  . pytest
PYTHONPATH="$WORKSPACE:$release_python" python3 -m pytest -q
node --test tests/*.test.mjs
python3 -m py_compile wechat_bridge_collector/*.py
bash -n agent-skill/scripts/setup_macos.sh
jq -e . connector.json >/dev/null
test "$(jq -r '.transport.type' connector.json)" = "http"
test "$(jq -r '.events[0].name' connector.json)" = "messageReceived"
test -f ui/index.html
test -f ui/app.js
test -f ui/styles.css
test -f ui/time-range.mjs
test -f ui/session-model.mjs
'''
            }
        }

        stage('Package source artifact') {
            steps {
                sh '''#!/bin/bash
set -euo pipefail
artifact_dir="$WORKSPACE/.release-artifacts"
case "$artifact_dir" in "$WORKSPACE"/*) ;; *) exit 1 ;; esac
rm -rf -- "$artifact_dir"
mkdir -p "$artifact_dir"

archive_name="wechat-bridge-collector-${CONNECTOR_VERSION}-source.zip"
archive="$artifact_dir/$archive_name"
git archive --format=zip --prefix="wechat-bridge-collector-${CONNECTOR_VERSION}/" \
  "$SOURCE_COMMIT" -o "$archive"
checksum="$(sha256sum "$archive" | awk '{print $1}')"
printf '%s  %s\n' "$checksum" "$archive_name" > "$archive.sha256"

archive_listing="$(unzip -Z1 "$archive")"
grep -Eq '/connector[.]json$' <<<"$archive_listing"
grep -Eq '/pyproject[.]toml$' <<<"$archive_listing"
grep -Eq '/vendor/wechat-decrypt/key_utils[.]py$' <<<"$archive_listing"
grep -Eq '/vendor/wechat-decrypt/find_all_keys[.]py$' <<<"$archive_listing"
grep -Eq '/vendor/wechat-decrypt/find_all_keys_windows[.]py$' <<<"$archive_listing"
grep -Eq '/vendor/wechat-decrypt/find_all_keys_macos[.]c$' <<<"$archive_listing"
grep -Eq '/ui/time-range[.]mjs$' <<<"$archive_listing"
grep -Eq '/ui/session-model[.]mjs$' <<<"$archive_listing"
unzip -p "$archive" '*/connector.json' | jq -e --arg version "$CONNECTOR_VERSION" \
  '.version == $version and .source.revision == ("v" + $version)' >/dev/null
unzip -p "$archive" '*/pyproject.toml' | grep -Fx 'requires-python = ">=3.10"' >/dev/null

jq -n \
  --arg version "$CONNECTOR_VERSION" \
  --arg commit "$SOURCE_COMMIT" \
  --arg file "$archive_name" \
  --arg checksum "$checksum" \
  '{version:$version,sourceCommit:$commit,file:$file,sha256:$checksum}' \
  > "$artifact_dir/build-metadata.json"
'''
                archiveArtifacts artifacts: '.release-artifacts/*', fingerprint: true
            }
        }
    }

    post {
        always {
            sh '''#!/bin/bash
set -euo pipefail
artifact_dir="$WORKSPACE/.release-artifacts"
case "$artifact_dir" in "$WORKSPACE"/*) ;; *) exit 0 ;; esac
rm -rf -- "$artifact_dir"
'''
        }
    }
}
