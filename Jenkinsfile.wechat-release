pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(name: 'SOURCE_REF', defaultValue: 'main', description: 'Source branch containing the release commit')
        string(name: 'SOURCE_COMMIT', defaultValue: '', description: 'Exact source commit to publish')
        string(name: 'CONNECTOR_VERSION', defaultValue: '2.0.0', description: 'WeChat Connector version')
        string(name: 'MIN_BRIDGE_VERSION', defaultValue: '0.1.117', description: 'Minimum compatible Bridge Agent version')
        booleanParam(name: 'DRY_RUN', defaultValue: true, description: 'Validate and test without publishing Git refs')
    }

    stages {
        stage('Validate release input') {
            steps {
                sh '''#!/bin/bash
set -euo pipefail
test -n "$SOURCE_COMMIT"
test "$SOURCE_REF" = "main"
test "$(git rev-parse HEAD)" = "$SOURCE_COMMIT"
test "$(git ls-remote https://gitee.com/zxflimit_admin/wechat-bridge-collector.git refs/heads/main | awk 'NR == 1 {print $1}')" = "$SOURCE_COMMIT"
test "$(jq -r '.version' connector.json)" = "$CONNECTOR_VERSION"
test "$(jq -r '.source.revision' connector.json)" = "v${CONNECTOR_VERSION}"
test "$(jq -r '.schemaVersion' connector.json)" = "2.0"
test "$(jq -r '.runtime.command' connector.json)" = "wechat-bridge-collector-python"
test "$(jq -r '.runtime.startPolicy' connector.json)" = "manual"
test "$(jq -r '.ui.entry' connector.json)" = "ui/index.html"
test "$(jq -r '.management.auth.type' connector.json)" = "connector_token"
test "$(sed -n 's/^version = "\\([^"]*\\)"/\\1/p' pyproject.toml | head -1)" = "$CONNECTOR_VERSION"
test "$(sed -n 's/^__version__ = "\\([^"]*\\)"/\\1/p' wechat_bridge_collector/__init__.py)" = "$CONNECTOR_VERSION"
test "$(sed -n 's/^version = "\\([^\"]*\\)"/\\1/p' Cargo.toml | head -1)" = "$CONNECTOR_VERSION"
test ! -e .gitmodules
test -f vendor/wechat-decrypt.upstream.json
test "$(jq -r '.commit' vendor/wechat-decrypt.upstream.json)" = "5e0eaa33fa1e77e533392db394644216c5ea6824"
test -f vendor/wechat-decrypt/key_utils.py
test -f vendor/wechat-decrypt/find_all_keys.py
test -f vendor/wechat-decrypt/find_all_keys_windows.py
test -f vendor/wechat-decrypt/find_all_keys_macos.c
test ! -e wechat_bridge_collector/scripts/macos/com.baijimu.wechat-bridge-collector.plist
! jq -e '.hooks.installAutostart' connector.json >/dev/null
case "$CONNECTOR_VERSION" in *[!0-9.]*|'') exit 1 ;; esac
case "$MIN_BRIDGE_VERSION" in *[!0-9.]*|'') exit 1 ;; esac
'''
            }
        }

        stage('Test release source') {
            steps {
                sh '''#!/bin/bash
set -euo pipefail
release_python="$WORKSPACE/.release-python"
case "$release_python" in "$WORKSPACE"/*) ;; *) exit 1 ;; esac
trap 'rm -rf -- "$release_python"' EXIT
python3 -m pip install \
  --disable-pip-version-check \
  --index-url https://mirrors.aliyun.com/pypi/simple/ \
  --target "$release_python" \
  . pytest
PYTHONPATH="$release_python:$WORKSPACE" python3 -m pytest -q
python3 -m py_compile wechat_bridge_collector/*.py
bash -n agent-skill/scripts/setup_macos.sh
jq -e . connector.json >/dev/null
test "$(jq -r '.transport.type' connector.json)" = "http"
test "$(jq -r '.events[0].name' connector.json)" = "messageReceived"
test -f ui/index.html
test -f ui/app.js
test -f ui/styles.css
'''
            }
        }

        stage('Publish immutable source ref') {
            when {
                expression { return !params.DRY_RUN }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-momoplan-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    ),
                    usernamePassword(
                        credentialsId: 'bd5fa0ff-2186-41e4-a7aa-97937ef32c02',
                        usernameVariable: 'GITEE_USER',
                        passwordVariable: 'GITEE_TOKEN'
                    )
                ]) {
                    sh '''#!/bin/bash
set -euo pipefail
set +x
askpass="$WORKSPACE/.wechat-release-git-askpass.sh"
trap 'rm -f "$askpass"' EXIT
cat > "$askpass" <<'ASKPASS'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\n' "$GIT_AUTH_USER" ;;
  *Password*) printf '%s\n' "$GIT_AUTH_PASSWORD" ;;
  *) exit 1 ;;
esac
ASKPASS
chmod 700 "$askpass"
export GIT_ASKPASS="$askpass"
export GIT_TERMINAL_PROMPT=0

publish_remote() {
  remote="$1"
  current_main="$(git ls-remote "$remote" refs/heads/main | awk 'NR == 1 {print $1}')"
  if [ -n "$current_main" ] && ! git merge-base --is-ancestor "$current_main" "$SOURCE_COMMIT"; then
    echo "refusing non-fast-forward publish to main on $remote" >&2
    exit 1
  fi
  git push "$remote" "$SOURCE_COMMIT:refs/heads/main"

  tag="v${CONNECTOR_VERSION}"
  current_tag="$(git ls-remote "$remote" "refs/tags/$tag" | awk 'NR == 1 {print $1}')"
  if [ -n "$current_tag" ]; then
    test "$current_tag" = "$SOURCE_COMMIT"
  else
    git push "$remote" "$SOURCE_COMMIT:refs/tags/$tag"
  fi
}

export GIT_AUTH_USER="$GITEE_USER"
export GIT_AUTH_PASSWORD="$GITEE_TOKEN"
publish_remote "https://gitee.com/zxflimit_admin/wechat-bridge-collector.git"
export GIT_AUTH_USER="$GITHUB_USER"
export GIT_AUTH_PASSWORD="$GITHUB_TOKEN"
publish_remote "https://github.com/momoplan/wechat-bridge-collector.git"
'''
                }
            }
        }

        stage('Verify published release') {
            when {
                expression { return !params.DRY_RUN }
            }
            steps {
                sh '''#!/bin/bash
set -euo pipefail
for remote in \
  https://github.com/momoplan/wechat-bridge-collector.git \
  https://gitee.com/zxflimit_admin/wechat-bridge-collector.git; do
  tag_commit="$(git ls-remote "$remote" "refs/tags/v${CONNECTOR_VERSION}" | awk 'NR == 1 {print $1}')"
  test "$tag_commit" = "$SOURCE_COMMIT"
done

release_verify_dir="$(mktemp -d)"
case "$release_verify_dir" in /tmp/*|/private/tmp/*) ;; *) exit 1 ;; esac
trap 'rm -rf -- "$release_verify_dir"' EXIT

verify_archive() {
  archive_url="$1"
  archive_name="$2"
  archive_path="$release_verify_dir/$archive_name"
  curl -fL --retry 5 --retry-all-errors --connect-timeout 10 --max-time 120 \
    "$archive_url" -o "$archive_path"
  sha256sum "$archive_path"
  unzip -Z1 "$archive_path" | grep -Eq '/vendor/wechat-decrypt/key_utils\.py$'
  unzip -Z1 "$archive_path" | grep -Eq '/vendor/wechat-decrypt/find_all_keys\.py$'
  unzip -Z1 "$archive_path" | grep -Eq '/vendor/wechat-decrypt/find_all_keys_windows\.py$'
  unzip -Z1 "$archive_path" | grep -Eq '/vendor/wechat-decrypt/find_all_keys_macos\.c$'
  unzip -p "$archive_path" '*/connector.json' | jq -e --arg version "$CONNECTOR_VERSION" \
    '.version == $version and .source.revision == ("v" + $version)' >/dev/null
}

verify_archive \
  "https://github.com/momoplan/wechat-bridge-collector/archive/v${CONNECTOR_VERSION}.zip" \
  github.zip
verify_archive \
  "https://gitee.com/zxflimit_admin/wechat-bridge-collector/repository/archive/v${CONNECTOR_VERSION}.zip" \
  gitee.zip
'''
            }
        }
    }
}
