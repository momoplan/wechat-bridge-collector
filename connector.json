{
  "schemaVersion": "1.2",
  "id": "com.baijimu.connector.wechat",
  "name": "WeChat Connector",
  "version": "0.6.0",
  "description": "Read local WeChat 4.x messages on this computer and expose read-only query methods through Baijimu Local.",
  "publisher": {
    "name": "Baijimu",
    "homepage": "https://baijimu.com"
  },
  "source": {
    "type": "github",
    "repo": "momoplan/wechat-bridge-collector",
    "revision": "v0.6.0"
  },
  "runtime": {
    "type": "process",
    "command": "wechat-bridge-collector-python",
    "args": ["start"],
    "startPolicy": "manual",
    "healthCheck": {
      "type": "http",
      "url": "http://127.0.0.1:18082/health",
      "timeoutSecs": 2,
      "expectStatus": 200
    }
  },
  "permissions": [
    {
      "id": "macos.fullDiskAccess",
      "title": "完全磁盘访问",
      "description": "读取微信沙盒中的本地数据库；请把百积木加入系统设置的完全磁盘访问列表。",
      "platforms": ["macos"]
    }
  ],
  "legacyAutostartLabels": ["com.baijimu.wechat-bridge-collector"],
  "management": {
    "type": "http",
    "baseUrl": "http://127.0.0.1:18082",
    "auth": {
      "type": "connector_token"
    },
    "operations": {
      "runtimeState": {
        "method": "GET",
        "path": "/management/v1/state"
      },
      "acquireKeys": {
        "method": "POST",
        "path": "/management/v1/acquire-keys"
      },
      "importKeys": {
        "method": "POST",
        "path": "/management/v1/import-keys"
      },
      "retrySetup": {
        "method": "POST",
        "path": "/management/v1/retry-setup"
      },
      "getRecentSessions": {
        "method": "POST",
        "path": "/management/v1/recent-sessions"
      },
      "getContacts": {
        "method": "POST",
        "path": "/management/v1/contacts"
      },
      "getChatHistory": {
        "method": "POST",
        "path": "/management/v1/chat-history"
      },
      "searchMessages": {
        "method": "POST",
        "path": "/management/v1/search"
      },
      "getMessageById": {
        "method": "POST",
        "path": "/management/v1/message"
      }
    }
  },
  "ui": {
    "type": "embedded",
    "entry": "ui/index.html",
    "title": "微信消息",
    "defaultView": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "methodPort": {
        "type": "integer",
        "default": 18082,
        "minimum": 1024,
        "maximum": 65535
      },
      "includeText": {
        "type": "boolean",
        "default": true
      },
      "includeOutgoing": {
        "type": "boolean",
        "default": true
      }
    },
    "additionalProperties": false
  },
  "remoteCapabilities": [
    {
      "name": "wechat.messages.read",
      "risk": "high",
      "description": "Read local WeChat message history after the user configures local database access."
    },
    {
      "name": "wechat.messages.search",
      "risk": "high",
      "description": "Search local WeChat messages by keyword."
    },
    {
      "name": "wechat.events.messageReceived",
      "risk": "high",
      "description": "Emit local WeChat message notifications through Baijimu Local."
    }
  ],
  "serviceRegistrationFiles": ["service-registration.json"],
  "hooks": {
    "setup": "wechat-bridge-collector-python setup",
    "probe": "wechat-bridge-collector-python probe"
  }
}
